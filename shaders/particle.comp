#version 450

layout(local_size_x = 64) in;

struct Particle {
    vec4 position_age;
    vec4 velocity_rotation;
    vec4 sizes;
    vec4 color;
    uvec4 meta;
    vec4 previous_depth;
};

struct Emitter {
    uvec4 meta0;
    uvec4 meta1;
    vec4 transform0;
    vec4 transform1;
    vec4 position_range;
    vec4 velocity_range;
    vec4 lifetime_spawn;
    vec4 rotation_range;
    vec4 size_range;
    vec4 color_start;
    vec4 color_end;
    vec4 forces;
    vec4 flipbook;
    uvec4 settings;
    vec4 advanced0;
    vec4 force_center;
    vec4 attractor;
    vec4 repulsor;
    vec4 vector_field;
    vec4 collision_plane;
    vec4 collision_extra;
    vec4 depth_velocity;
    vec4 render0;
    vec4 render1;
    uvec4 sub_settings;
    uvec4 event_settings;
};

struct EmitterState {
    vec4 values;
    uvec4 meta;
    uvec4 event_meta;
};

layout(std430, binding = 0) buffer Particles { Particle particles[]; };
layout(std430, binding = 1) buffer AliveA { uint alive_a[]; };
layout(std430, binding = 2) buffer AliveB { uint alive_b[]; };
layout(std430, binding = 3) buffer Dead { uint dead_indices[]; };
layout(std430, binding = 4) buffer Counters {
    uvec4 counters;
    uvec4 draw_command;
};
layout(std430, binding = 5) readonly buffer Emitters { Emitter emitters[]; };
layout(std430, binding = 6) buffer EmitterStates { EmitterState emitter_states[]; };
layout(std430, binding = 7) readonly buffer PathPoints { vec2 path_points[]; };

layout(push_constant) uniform ParticleStep {
    uint pass_index;
    uint parity;
    uint capacity;
    uint emitter_count;
    float delta_time;
    uint step_serial;
    uint reserved0;
    uint reserved1;
} step;

uint random_bits(uint seed, uvec2 emitter_id, uint serial, uint lane) {
    uint value = seed ^ emitter_id.x ^ emitter_id.y;
    value ^= serial * 0x9e3779b9U;
    value ^= lane * 0x85ebca6bU;
    value ^= value >> 16U;
    value *= 0x7feb352dU;
    value ^= value >> 15U;
    value *= 0x846ca68bU;
    value ^= value >> 16U;
    return value;
}

float random_unit(uint seed, uvec2 emitter_id, uint serial, uint lane) {
    return float(random_bits(seed, emitter_id, serial, lane) >> 8U) * (1.0 / 16777216.0);
}

bool pop_dead(out uint particle_index) {
    uint available = counters.z;
    while (available != 0U) {
        uint previous = atomicCompSwap(counters.z, available, available - 1U);
        if (previous == available) {
            particle_index = dead_indices[available - 1U];
            return true;
        }
        available = previous;
    }
    return false;
}

vec2 transform_vector(Emitter emitter, vec2 value) {
    return vec2(emitter.transform0.x * value.x + emitter.transform0.y * value.y,
                emitter.transform0.z * value.x + emitter.transform0.w * value.y);
}

vec2 transform_point(Emitter emitter, vec2 value) {
    return transform_vector(emitter, value) + emitter.transform1.xy;
}

vec2 emitter_position(Emitter emitter, uint serial) {
    float first = random_unit(emitter.meta0.w, emitter.meta1.xy, serial, 9U);
    float second = random_unit(emitter.meta0.w, emitter.meta1.xy, serial, 10U);
    vec2 bounds = emitter.transform1.zw;
    vec2 point = bounds * 0.5;
    if (emitter.meta0.x == 1U) {
        point = vec2(first * bounds.x, bounds.y * 0.5);
    } else if (emitter.meta0.x == 2U) {
        point = vec2(first * bounds.x, second * bounds.y);
    } else if (emitter.meta0.x == 3U) {
        float angle = first * 6.28318530718;
        vec2 radius = bounds * 0.5 * sqrt(second);
        point += vec2(cos(angle) * radius.x, sin(angle) * radius.y);
    } else if (emitter.meta0.x == 4U && emitter.meta1.w != 0U) {
        uint sample_index = min(uint(first * float(emitter.meta1.w)), emitter.meta1.w - 1U);
        point = path_points[emitter.meta1.z + sample_index];
    }
    vec2 offset = mix(emitter.position_range.xy, emitter.position_range.zw,
                      vec2(random_unit(emitter.meta0.w, emitter.meta1.xy, serial, 0U),
                           random_unit(emitter.meta0.w, emitter.meta1.xy, serial, 1U)));
    return transform_point(emitter, point + offset);
}

void initialize_particle(uint emitter_index, uint particle_index, uint serial, uint recursion_depth,
                         uint birth_pending) {
    Emitter emitter = emitters[emitter_index];
    vec2 velocity = mix(emitter.velocity_range.xy, emitter.velocity_range.zw,
                        vec2(random_unit(emitter.meta0.w, emitter.meta1.xy, serial, 2U),
                             random_unit(emitter.meta0.w, emitter.meta1.xy, serial, 3U)));
    float rotation = mix(emitter.rotation_range.x, emitter.rotation_range.y,
                         random_unit(emitter.meta0.w, emitter.meta1.xy, serial, 4U));
    float angular_velocity = mix(emitter.rotation_range.z, emitter.rotation_range.w,
                                 random_unit(emitter.meta0.w, emitter.meta1.xy, serial, 5U));
    float start_size = mix(emitter.size_range.x, emitter.size_range.y,
                           random_unit(emitter.meta0.w, emitter.meta1.xy, serial, 6U));
    float end_size = mix(emitter.size_range.z, emitter.size_range.w,
                         random_unit(emitter.meta0.w, emitter.meta1.xy, serial, 7U));
    float lifetime = mix(emitter.lifetime_spawn.x, emitter.lifetime_spawn.y,
                         random_unit(emitter.meta0.w, emitter.meta1.xy, serial, 8U));
    particles[particle_index].position_age = vec4(emitter_position(emitter, serial), 0.0, lifetime);
    particles[particle_index].velocity_rotation =
        vec4(transform_vector(emitter, velocity), rotation, angular_velocity);
    particles[particle_index].sizes = vec4(start_size, end_size, start_size, 0.0);
    particles[particle_index].color = emitter.color_start;
    particles[particle_index].meta =
        uvec4(emitter_index, emitter.meta0.y, recursion_depth, birth_pending);
    particles[particle_index].previous_depth =
        vec4(particles[particle_index].position_age.xy,
             (emitter.collision_extra.y + emitter.collision_extra.z) * 0.5,
             mix(emitter.depth_velocity.x, emitter.depth_velocity.y,
                 random_unit(emitter.meta0.w, emitter.meta1.xy, serial, 11U)));
}

void append_alive(uint particle_index) {
    uint output_slot = atomicAdd(counters.y, 1U);
    if (step.parity == 0U) {
        alive_b[output_slot] = particle_index;
    } else {
        alive_a[output_slot] = particle_index;
    }
}

bool spawn_particle(uint emitter_index, uint recursion_depth, vec2 parent_position,
                    float parent_depth, bool inherit_position) {
    Emitter emitter = emitters[emitter_index];
    uint emitter_alive = atomicAdd(emitter_states[emitter_index].meta.z, 1U);
    if (emitter_alive >= emitter.meta0.z) {
        atomicAdd(emitter_states[emitter_index].meta.z, uint(-1));
        atomicAdd(emitter_states[emitter_index].meta.w, 1U);
        atomicAdd(counters.w, 1U);
        return false;
    }
    uint particle_index = 0U;
    if (!pop_dead(particle_index)) {
        atomicAdd(emitter_states[emitter_index].meta.z, uint(-1));
        atomicAdd(emitter_states[emitter_index].meta.w, 1U);
        atomicAdd(counters.w, 1U);
        return false;
    }
    uint serial = atomicAdd(emitter_states[emitter_index].meta.x, 1U);
    initialize_particle(emitter_index, particle_index, serial, recursion_depth, 1U);
    if (inherit_position) {
        particles[particle_index].position_age.xy = parent_position;
        particles[particle_index].previous_depth.xy = parent_position;
        particles[particle_index].previous_depth.z = parent_depth;
    }
    append_alive(particle_index);
    return true;
}

vec2 safe_direction(vec2 value) {
    float magnitude = length(value);
    return magnitude > 0.00001 ? value / magnitude : vec2(0.0);
}

vec2 advanced_force(Emitter emitter, vec2 position, float time) {
    vec2 force = emitter.forces.xy + emitter.forces.zw;
    if (emitter.advanced0.x != 0.0) {
        force += vec2(cos(position.y * emitter.advanced0.y + time),
                      sin(position.x * emitter.advanced0.y - time)) * emitter.advanced0.x;
    }
    vec2 direction = safe_direction(position - emitter.force_center.xy);
    force += direction * emitter.advanced0.z + vec2(-direction.y, direction.x) * emitter.advanced0.w;
    vec2 delta = emitter.attractor.xy - position;
    float distance_to_force = length(delta);
    if (emitter.attractor.w > 0.0 && distance_to_force < emitter.attractor.w) {
        force += safe_direction(delta) * emitter.attractor.z *
                 (1.0 - distance_to_force / emitter.attractor.w);
    }
    delta = position - emitter.repulsor.xy;
    distance_to_force = length(delta);
    if (emitter.repulsor.w > 0.0 && distance_to_force < emitter.repulsor.w) {
        force += safe_direction(delta) * emitter.repulsor.z *
                 (1.0 - distance_to_force / emitter.repulsor.w);
    }
    force += safe_direction(emitter.vector_field.xy) * emitter.vector_field.z;
    float magnitude = length(force);
    return magnitude > 100000.0 ? force * (100000.0 / magnitude) : force;
}

bool invalid_vector(vec2 value) {
    return any(isnan(value)) || any(isinf(value));
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (step.pass_index == 0U) {
        if (index < step.capacity) {
            dead_indices[index] = step.capacity - index - 1U;
            particles[index] = Particle(vec4(0.0), vec4(0.0), vec4(0.0), vec4(0.0),
                                        uvec4(0U), vec4(0.0));
        }
        if (index < step.emitter_count) {
            emitter_states[index].values = vec4(0.0);
            emitter_states[index].meta = uvec4(0U);
            emitter_states[index].event_meta = uvec4(0U);
        }
        if (index == 0U) {
            counters = uvec4(0U, 0U, step.capacity, 0U);
            draw_command = uvec4(6U, 0U, 0U, 0U);
        }
        return;
    }
    if (step.pass_index == 1U) {
        if (index == 0U) {
            counters.y = 0U;
        }
        return;
    }
    if (step.pass_index == 2U) {
        if (index >= counters.x) {
            return;
        }
        uint particle_index = step.parity == 0U ? alive_a[index] : alive_b[index];
        Particle particle = particles[particle_index];
        Emitter emitter = emitters[particle.meta.x];
        if (particle.meta.w != 0U) {
            particle.meta.w = 0U;
            if (emitter.sub_settings.x != uint(-1) && particle.meta.z < emitter.sub_settings.w &&
                particle.meta.z < 3U) {
                for (uint child = 0U; child < emitter.sub_settings.y; ++child) {
                    spawn_particle(emitter.sub_settings.x, particle.meta.z + 1U,
                                   particle.position_age.xy, particle.previous_depth.z, true);
                }
            }
        }
        particle.position_age.z += step.delta_time;
        if (particle.position_age.z >= particle.position_age.w) {
            uint dead_slot = atomicAdd(counters.z, 1U);
            dead_indices[dead_slot] = particle_index;
            atomicAdd(emitter_states[particle.meta.x].meta.z, uint(-1));
            if (emitter.sub_settings.x != uint(-1) && particle.meta.z < emitter.sub_settings.w &&
                particle.meta.z < 3U) {
                for (uint child = 0U; child < emitter.sub_settings.z; ++child) {
                    spawn_particle(emitter.sub_settings.x, particle.meta.z + 1U,
                                   particle.position_age.xy, particle.previous_depth.z, true);
                }
            }
            return;
        }
        particle.previous_depth.xy = particle.position_age.xy;
        particle.velocity_rotation.xy +=
            advanced_force(emitter, particle.position_age.xy,
                           float(step.step_serial) * step.delta_time) * step.delta_time;
        particle.velocity_rotation.xy /= 1.0 + emitter.lifetime_spawn.w * step.delta_time;
        particle.position_age.xy += particle.velocity_rotation.xy * step.delta_time;
        particle.previous_depth.z += particle.previous_depth.w * step.delta_time;
        if (emitter.event_settings.z != 0U) {
            vec2 normal = safe_direction(emitter.collision_plane.xy);
            float plane_distance = dot(particle.position_age.xy, normal) - emitter.collision_plane.z;
            if (plane_distance < 0.0) {
                particle.position_age.xy -= normal * plane_distance;
                float normal_speed = dot(particle.velocity_rotation.xy, normal);
                if (normal_speed < 0.0) {
                    particle.velocity_rotation.xy -=
                        (1.0 + emitter.collision_plane.w) * normal_speed * normal;
                    particle.velocity_rotation.xy *= 1.0 - emitter.collision_extra.x;
                }
            }
        }
        if (emitter.event_settings.w != 0U) {
            if (particle.previous_depth.z < emitter.collision_extra.y) {
                particle.previous_depth.z = emitter.collision_extra.y;
                particle.previous_depth.w = abs(particle.previous_depth.w) * emitter.collision_plane.w;
            } else if (particle.previous_depth.z > emitter.collision_extra.z) {
                particle.previous_depth.z = emitter.collision_extra.z;
                particle.previous_depth.w = -abs(particle.previous_depth.w) * emitter.collision_plane.w;
            }
        }
        if (invalid_vector(particle.position_age.xy) ||
            invalid_vector(particle.velocity_rotation.xy) ||
            isnan(particle.previous_depth.z) || isinf(particle.previous_depth.z)) {
            uint dead_slot = atomicAdd(counters.z, 1U);
            dead_indices[dead_slot] = particle_index;
            atomicAdd(emitter_states[particle.meta.x].meta.z, uint(-1));
            atomicAdd(emitter_states[particle.meta.x].meta.w, 1U);
            atomicAdd(counters.w, 1U);
            return;
        }
        particle.velocity_rotation.z += particle.velocity_rotation.w * step.delta_time;
        float amount = clamp(particle.position_age.z / particle.position_age.w, 0.0, 1.0);
        particle.sizes.z = mix(particle.sizes.x, particle.sizes.y, amount);
        particle.color = mix(emitter.color_start, emitter.color_end, amount);
        particles[particle_index] = particle;
        append_alive(particle_index);
        return;
    }
    if (step.pass_index == 3U) {
        if (index >= step.emitter_count || emitters[index].settings.y == 0U) {
            return;
        }
        Emitter emitter = emitters[index];
        float requested = min(emitter_states[index].values.x +
                              emitter.lifetime_spawn.z * step.delta_time,
                              float(emitter.meta0.z));
        uint spawn_count = uint(floor(requested));
        emitter_states[index].values.x = requested - float(spawn_count);
        if (emitter_states[index].meta.y == 0U) {
            spawn_count += emitter.settings.x;
            emitter_states[index].meta.y = 1U;
        }
        if (emitter.event_settings.y != emitter_states[index].event_meta.x) {
            spawn_count = min(emitter.meta0.z, spawn_count + emitter.event_settings.x);
            emitter_states[index].event_meta.x = emitter.event_settings.y;
        }
        spawn_count = min(spawn_count, emitter.meta0.z);
        for (uint spawn = 0U; spawn < spawn_count; ++spawn) {
            spawn_particle(index, 0U, vec2(0.0), 0.0, false);
        }
        return;
    }
    if (step.pass_index == 4U && index == 0U) {
        counters.x = counters.y;
        draw_command.y = counters.y;
    }
}
